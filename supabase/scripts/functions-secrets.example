# Edge function secrets for the new Supabase project (iukfjhzmjgvtxefhhshd).
#
# Usage:
#   cp supabase/scripts/functions-secrets.example .env.functions
#   # open .env.functions, put a value after each "=", then:
#   ./supabase/scripts/deploy-edge-functions.sh iukfjhzmjgvtxefhhshd
#
# .env.functions is gitignored (the ignore list is explicit filenames, not a
# wildcard -- an entry was added for this file). Do not commit it.
#
# NOTE: no trailing comments on the value lines. `supabase secrets set --env-file`
# reads dotenv format, and a trailing "# ..." can end up inside the value.
#
# NOT listed here on purpose -- the platform injects these at runtime and the
# CLI rejects attempts to set them:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL
#
# The "read by N functions" counts come from scanning Deno.env.get() across all 38.


# --- URLs ---------------------------------------------------------------------
# APP_URL      read by 6 functions
# FRONTEND_URL read by 2
APP_URL=https://qwohter.com
FRONTEND_URL=https://qwohter.com

# --- Stripe -------------------------------------------------------------------
# STRIPE_SECRET_KEY         read by 11
# STRIPE_SECRET_KEY_TEST    read by 3
# STRIPE_WEBHOOK_SECRET     read by 1 -- signing secret of the NEW webhook endpoint,
#                           created after the functions are deployed. Leave blank on
#                           the first run, then re-run with --secrets-only.
# STRIPE_CLI_WEBHOOK_SECRET read by 1 -- only for local `stripe listen`; can stay blank
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLI_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------------
# RESEND_API_KEY read by 9
RESEND_API_KEY=

# --- Google (Docs / Drive / OAuth) --------------------------------------------
# GOOGLE_CLIENT_ID     read by 9
# GOOGLE_CLIENT_SECRET read by 8
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI -----------------------------------------------------------------------
# OPENAI_API_KEY          read by 4
# AI_USE_FUNCTION_CALLING read by 1
OPENAI_API_KEY=
AI_USE_FUNCTION_CALLING=true

# --- Misc ---------------------------------------------------------------------
# MAPBOX_PUBLIC_TOKEN    read by 1
# DEV_IMPERSONATE_SECRET read by 1 -- generate a fresh random value; do not reuse
#                        the old project's
MAPBOX_PUBLIC_TOKEN=
DEV_IMPERSONATE_SECRET=
